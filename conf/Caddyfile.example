# Staging first: untrusted test certificates, no rate-limit risk.
# Delete this block once a certificate is issued.
{
	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

*.example.com {
	tls {
		dns route53 {
			hosted_zone_id {$ROUTE53_ZONE_ID}
		}
	}
	abort
}

app.example.com {
	reverse_proxy 192.0.2.20:8080
}